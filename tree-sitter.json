{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lyra",
      "scope": "source.lyra",
      "path": ".",
      "file-types": [
        "lyra",
        "lua"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^lyra$"
    }
  ],
  "metadata": {
    "version": "0.5.0",
    "license": "MIT",
    "authors": [
      {
        "name": "Daniel Alanis",
        "email": "ulises.alanis.255@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/HasSak-47/tree-sitter-lyra"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
